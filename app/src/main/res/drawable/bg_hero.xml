<?xml version="1.0" encoding="utf-8"?>
<!-- 首页英雄卡(v2.59 清汽水):白底 + 三团柔和径向渐变(紫/粉/薄荷)模拟
     mesh gradient,大圆角无描边,替代旧糖果贴纸风 bg_hero_pastel.png -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/stickerShadow" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/card" />
                    <corners android:radius="26dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="radial"
                        android:centerX="0.12"
                        android:centerY="0.25"
                        android:gradientRadius="200dp"
                        android:startColor="#388E6BFF"
                        android:endColor="#008E6BFF" />
                    <corners android:radius="26dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="radial"
                        android:centerX="0.88"
                        android:centerY="0.18"
                        android:gradientRadius="210dp"
                        android:startColor="#40F25C9C"
                        android:endColor="#00F25C9C" />
                    <corners android:radius="26dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="radial"
                        android:centerX="0.80"
                        android:centerY="0.95"
                        android:gradientRadius="190dp"
                        android:startColor="#302BC98A"
                        android:endColor="#002BC98A" />
                    <corners android:radius="26dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="radial"
                        android:centerX="0.30"
                        android:centerY="0.90"
                        android:gradientRadius="170dp"
                        android:startColor="#28FFCE55"
                        android:endColor="#00FFCE55" />
                    <corners android:radius="26dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</layer-list>
