<?xml version="1.0" encoding="utf-8"?>
<!-- 次按钮(设计合同 §6):colorSurface 底 + colorStroke 1dp 描边 pill,colorPrimary 文字。
     v2.61 包 M3 水波纹(primary 色) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/primary">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurface" />
            <stroke android:width="1dp" android:color="?attr/colorStroke" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</ripple>
