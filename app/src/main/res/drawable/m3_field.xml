<?xml version="1.0" encoding="utf-8"?>
<!-- M3 填充式文本框:聚焦=container + 底部 2dp primary 指示条;
     未聚焦=container + 底部 1dp 描边。圆角顶部 12dp(合同输入框值) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:topLeftRadius="12dp"
                        android:topRightRadius="12dp"
                        android:bottomLeftRadius="2dp"
                        android:bottomRightRadius="2dp" />
                    <solid android:color="?attr/subsurface" />
                </shape>
            </item>
            <item android:gravity="bottom" android:height="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/primary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:topLeftRadius="12dp"
                        android:topRightRadius="12dp"
                        android:bottomLeftRadius="2dp"
                        android:bottomRightRadius="2dp" />
                    <solid android:color="?attr/subsurface" />
                </shape>
            </item>
            <item android:gravity="bottom" android:height="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/line" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
