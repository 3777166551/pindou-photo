<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 基线配色(v2.60,Apache-2.0 可商用,官方规范 m3.material.io)。
     角色值 = M3 baseline light scheme,自定义只保留语义映射与点缀色:
     bg=surface / card=lowest / subsurface=container-high / line=outline-variant
     primary=#6750A4 / primary-container=#EADDFF / secondary-container=#E8DEF8
     文字=on-surface #1D1B20 / on-surface-variant #49454F。 -->
<resources>
    <!-- 墨色:仅存于代码级画布元素(框选/帧线) -->
    <color name="ink">#322F35</color>
    <color name="inkSoft">#E7E0EC</color>

    <!-- 底与卡(M3 surface 层级) -->
    <color name="bg">#FEF7FF</color>
    <color name="card">#FFFFFF</color>
    <color name="subsurface">#ECE6F0</color>
    <color name="line">#CAC4D0</color>
    <color name="stickerShadow">#E6E0E9</color>
    <color name="surfaceContainerLow">#F7F2FA</color>
    <color name="primaryContainer">#EADDFF</color>
    <color name="onPrimaryContainer">#21005D</color>
    <color name="secondaryContainer">#E8DEF8</color>
    <color name="onSecondaryContainer">#1D192B</color>

    <!-- 顶栏(半透明,随底色) -->
    <color name="headerBg">#F2F7F7FB</color>

    <!-- 主操作:M3 基线紫;onPrimary = 主按钮上的文字色(深色主题切深紫) -->
    <color name="primary">#6750A4</color>
    <color name="onPrimary">#FFFFFF</color>
    <color name="primaryDark">#4F378A</color>
    <color name="primaryLight">#EADDFF</color>
    <color name="gradStart">#6750A4</color>
    <color name="gradEnd">#6750A4</color>

    <!-- 文字(M3 on-surface 角色) -->
    <color name="textMain">#1D1B20</color>
    <color name="textSub">#49454F</color>

    <!-- 多巴胺点缀(仅图标盘/徽章/庆祝;状态色) -->
    <color name="accentMint">#2BC98A</color>
    <color name="mintSoft">#D9F5E8</color>
    <color name="butter">#FFCE55</color>
    <color name="butterSoft">#FFF3D2</color>
    <color name="lilac">#A78BFA</color>
    <color name="lilacSoft">#ECE6FF</color>
    <color name="sky">#4FB8F5</color>
    <color name="skySoft">#DFF2FF</color>
    <color name="peach">#FF9A6B</color>
    <color name="peachSoft">#FFE8DB</color>
    <color name="danger">#B3261E</color>
    <!-- 提示文字的琥珀色(浅底深琥珀/深底浅琥珀) -->
    <color name="tipAmber">#A66300</color>

    <color name="ic_launcher_bg">#EADDFF</color>

    <!-- ═══ 设计合同 token(docs/设计合同.md §1,逐页迁移,新代码只用这些) ═══ -->
    <color name="colorPrimary">#6750A4</color>
    <color name="colorPrimaryContainer">#EADDFF</color>
    <color name="colorBackground">#FAF7FD</color>
    <color name="colorSurface">#F3EFF9</color>
    <color name="colorStroke">#E2D9F0</color>
    <color name="textPrimary">#1D1B20</color>
    <color name="textSecondary">#6B6577</color>
    <color name="colorSuccess">#2E9E6B</color>
    <color name="colorWarning">#E8A13D</color>
    <color name="colorDanger">#C62828</color>
    <!-- 主 CTA 卡片(浅紫 container 底)上的次级文字 -->
    <color name="onPrimaryContainerDim">#BF21005D</color>
</resources>
