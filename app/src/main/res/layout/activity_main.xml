<?xml version="1.0" encoding="utf-8"?>
<!-- 首页(v2.60 设计合同锚点页,docs/设计合同.md §8):
     品牌区 → 主 CTA 卡(浅紫 container 底)→ 我的项目 → 模板库/豆料库存
     → 折叠「实用工具」。首屏不滚动可见全部主入口;图标为统一 2dp 线性
     图标(合同 §4),左对齐同轴;间距 8pt 网格(页边距 20/卡距 12/卡内 16)。
     控件 ID 全部保持不变(冒烟按 id 点击)。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pegboard"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- 品牌区 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:letterSpacing="0.03"
            android:text="@string/app_name"
            android:textColor="?attr/textPrimary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/main_footer"
            android:textColor="?attr/textSecondary"
            android:textSize="13sp" />

        <!-- 主 CTA 大卡片(合同 §6/§8:浅紫 container 底 + 24dp 圆角) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_camera"
                    android:tint="?attr/onPrimaryContainer" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_new_title"
                        android:textColor="?attr/onPrimaryContainer"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/main_new_desc"
                        android:textColor="?attr/onPrimaryContainerDim"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 主按钮:colorPrimary pill + onPrimary 字,高 52dp(合同 §6) -->
            <TextView
                android:id="@+id/btnGallery"
                style="@style/BigBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_primary"
                android:elevation="0dp"
                android:text="@string/main_pick_gallery"
                android:textColor="?attr/onPrimary" />

            <!-- 次按钮:colorSurface 底 + colorStroke 描边 pill,colorPrimary 字 -->
            <TextView
                android:id="@+id/btnCamera"
                style="@style/BigBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_secondary"
                android:elevation="0dp"
                android:text="@string/main_pick_camera"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>

        <!-- 我的项目:回访用户最高频动作 -->
        <LinearLayout
            android:id="@+id/btnProjects"
            style="@style/ToolCardWide"
            android:layout_marginTop="12dp">

            <ImageView
                style="@style/ToolCardIconPlate"
                android:contentDescription="@null"
                android:background="@drawable/bg_icon_sky"
                android:src="@drawable/ic_folder"
                android:tint="?attr/textPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/ToolCardTitle" android:text="@string/tool_projects" />
                <TextView style="@style/ToolCardDesc" android:text="@string/tool_projects_desc" />
            </LinearLayout>
        </LinearLayout>

        <!-- 常用双列:模板库 + 豆料库存 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnTemplates"
                style="@style/ToolCard"
                android:layout_marginEnd="6dp">

                <ImageView
                    style="@style/ToolCardIconPlate"
                    android:contentDescription="@null"
                    android:background="@drawable/bg_icon_lilac"
                    android:src="@drawable/ic_grid"
                    android:tint="?attr/textPrimary" />

                <TextView style="@style/ToolCardTitle" android:text="@string/tool_templates" />
                <TextView
                    android:id="@+id/toolTemplatesDesc"
                    style="@style/ToolCardDesc"
                    android:text="@string/tool_templates_desc" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnInventoryHome"
                style="@style/ToolCard"
                android:layout_marginStart="6dp">

                <ImageView
                    style="@style/ToolCardIconPlate"
                    android:contentDescription="@null"
                    android:background="@drawable/bg_icon_mint"
                    android:src="@drawable/ic_bag"
                    android:tint="?attr/textPrimary" />

                <TextView style="@style/ToolCardTitle" android:text="@string/tool_inventory" />
                <TextView style="@style/ToolCardDesc" android:text="@string/tool_inventory_desc" />
            </LinearLayout>
        </LinearLayout>

        <!-- 实用工具:低频工具统一收进折叠区(默认收起) -->
        <LinearLayout
            android:id="@+id/moreToolsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_sketch"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_tools"
                android:textColor="?attr/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/tvMoreToolsArrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/moreToolsBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/cardWatermark"
                style="@style/ToolCardWide">

                <ImageView
                    style="@style/ToolCardIconPlate"
                    android:contentDescription="@null"
                    android:background="@drawable/bg_icon_mint"
                    android:src="@drawable/ic_eraser"
                    android:tint="?attr/textPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/ToolCardTitle" android:text="@string/tool_watermark" />
                    <TextView style="@style/ToolCardDesc" android:text="@string/tool_watermark_desc" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnScanPattern"
                    style="@style/ToolCard"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        style="@style/ToolCardIconPlate"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_icon_sky"
                        android:src="@drawable/ic_scan"
                        android:tint="?attr/textPrimary" />

                    <TextView style="@style/ToolCardTitle" android:text="@string/tool_scan" />
                    <TextView style="@style/ToolCardDesc" android:text="@string/tool_scan_desc" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnText"
                    style="@style/ToolCard"
                    android:layout_marginStart="6dp">

                    <ImageView
                        style="@style/ToolCardIconPlate"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_icon_butter"
                        android:src="@drawable/ic_type"
                        android:tint="?attr/textPrimary" />

                    <TextView style="@style/ToolCardTitle" android:text="@string/tool_text" />
                    <TextView style="@style/ToolCardDesc" android:text="@string/tool_text_desc" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnBlank"
                    style="@style/ToolCard"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        style="@style/ToolCardIconPlate"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_icon_peach"
                        android:src="@drawable/ic_pencil"
                        android:tint="?attr/textPrimary" />

                    <TextView style="@style/ToolCardTitle" android:text="@string/tool_blank" />
                    <TextView style="@style/ToolCardDesc" android:text="@string/tool_blank_desc" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnKnowledge"
                    style="@style/ToolCard"
                    android:layout_marginStart="6dp">

                    <ImageView
                        style="@style/ToolCardIconPlate"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_icon_pink"
                        android:src="@drawable/ic_book"
                        android:tint="?attr/textPrimary" />

                    <TextView style="@style/ToolCardTitle" android:text="@string/tool_knowledge" />
                    <TextView style="@style/ToolCardDesc" android:text="@string/tool_knowledge_desc" />
                </LinearLayout>
            </LinearLayout>

            <!-- 备份与恢复:全量数据打包导出/导入(换机刚需) -->
            <LinearLayout
                android:id="@+id/btnBackup"
                style="@style/ToolCardWide"
                android:layout_marginTop="12dp">

                <ImageView
                    style="@style/ToolCardIconPlate"
                    android:contentDescription="@null"
                    android:background="@drawable/bg_icon_butter"
                    android:src="@drawable/ic_archive"
                    android:tint="?attr/textPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/ToolCardTitle" android:text="@string/tool_backup" />
                    <TextView style="@style/ToolCardDesc" android:text="@string/tool_backup_desc" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
