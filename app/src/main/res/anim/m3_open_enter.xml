<?xml version="1.0" encoding="utf-8"?>
<!-- M3 转场·进入:淡入 + 轻缩放(0.97→1),emphasized decelerate -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quad">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="220" />
    <scale android:fromXScale="0.97" android:toXScale="1"
        android:fromYScale="0.97" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="220" />
</set>
