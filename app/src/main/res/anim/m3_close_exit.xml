<?xml version="1.0" encoding="utf-8"?>
<!-- M3 转场·返回退出:淡出 + 轻缩放(1→0.98) -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_quad">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="200" />
    <scale android:fromXScale="1" android:toXScale="0.98"
        android:fromYScale="1" android:toYScale="0.98"
        android:pivotX="50%" android:pivotY="50%" android:duration="200" />
</set>
