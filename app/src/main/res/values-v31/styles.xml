<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+(API 31):AppTheme 切到 Material You 框架壁纸色板。
     system_accent1/2/3 = 主/次/三次调色板,system_neutral1/2 = 中性;
     后缀 0..1000 = 从"最表面"到"最文字",框架随系统深浅模式自动翻转取值方向,
     因此同一套角色映射在深浅两种模式下都成立(浅色:_0=白/_1000=黑,深色自动反转)。
     API 24~30 回落 values/styles.xml 静态紫。 -->
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@android:color/system_accent1_600</item>
        <item name="android:colorPrimaryDark">@android:color/system_neutral1_0</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:statusBarColor">@android:color/system_neutral1_0</item>
        <item name="android:navigationBarColor">@android:color/system_neutral1_0</item>
        <item name="android:windowBackground">@drawable/bg_pegboard</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowAnimationStyle">@style/M3WindowAnim</item>
        <item name="android:alertDialogTheme">@style/CandyAlertDialog</item>
        <!-- Material You 语义色(0=表面极,1000=文字极;深浅模式自动翻转) -->
        <item name="textMain">@android:color/system_neutral1_1000</item>
        <item name="textPrimary">@android:color/system_neutral1_1000</item>
        <item name="textSub">@android:color/system_neutral1_700</item>
        <item name="textSecondary">@android:color/system_neutral1_600</item>
        <item name="text_chip">@color/text_chip</item>
        <item name="text_tab">@color/text_tab</item>
        <item name="primary">@android:color/system_accent1_600</item>
        <item name="colorPrimary">@android:color/system_accent1_600</item>
        <item name="onPrimary">@android:color/system_accent1_0</item>
        <item name="primaryContainer">@android:color/system_accent1_100</item>
        <item name="onPrimaryContainer">@android:color/system_accent1_1000</item>
        <item name="onPrimaryContainerDim">@android:color/system_accent1_700</item>
        <item name="colorSurface">@android:color/system_neutral1_0</item>
        <item name="surfaceContainerLow">@android:color/system_neutral1_10</item>
        <item name="secondaryContainer">@android:color/system_accent2_50</item>
        <item name="onSecondaryContainer">@android:color/system_accent2_1000</item>
        <item name="subsurface">@android:color/system_neutral2_50</item>
        <item name="line">@android:color/system_neutral1_400</item>
        <item name="colorStroke">@android:color/system_neutral1_200</item>
        <item name="card">@android:color/system_neutral1_10</item>
        <item name="bg">@android:color/system_neutral1_0</item>
    </style>

    <style name="CandyTokens" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="textMain">@android:color/system_neutral1_1000</item>
        <item name="textPrimary">@android:color/system_neutral1_1000</item>
        <item name="textSub">@android:color/system_neutral1_700</item>
        <item name="textSecondary">@android:color/system_neutral1_600</item>
        <item name="text_chip">@color/text_chip</item>
        <item name="text_tab">@color/text_tab</item>
        <item name="primary">@android:color/system_accent1_600</item>
        <item name="colorPrimary">@android:color/system_accent1_600</item>
        <item name="onPrimary">@android:color/system_accent1_0</item>
        <item name="primaryContainer">@android:color/system_accent1_100</item>
        <item name="onPrimaryContainer">@android:color/system_accent1_1000</item>
        <item name="onPrimaryContainerDim">@android:color/system_accent1_700</item>
        <item name="colorSurface">@android:color/system_neutral1_0</item>
        <item name="surfaceContainerLow">@android:color/system_neutral1_10</item>
        <item name="secondaryContainer">@android:color/system_accent2_50</item>
        <item name="onSecondaryContainer">@android:color/system_accent2_1000</item>
        <item name="subsurface">@android:color/system_neutral2_50</item>
        <item name="line">@android:color/system_neutral1_400</item>
        <item name="colorStroke">@android:color/system_neutral1_200</item>
        <item name="card">@android:color/system_neutral1_10</item>
        <item name="bg">@android:color/system_neutral1_0</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:textColorPrimary">?attr/textMain</item>
        <item name="android:textColorSecondary">?attr/textSub</item>
        <item name="android:buttonBarButtonStyle">@style/M3DialogTextButton</item>
        <item name="android:windowMinWidthMinor">85%</item>
    </style>
</resources>
