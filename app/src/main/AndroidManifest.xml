<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 包名由 app/build.gradle 的 namespace 提供(AGP 8 起 Manifest 不再写 package) -->

    <!-- 仅 Android 9 及以下保存到相册需要;Android 10+ 用 MediaStore 无需权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- v2.26 起云端 AI 已移除:全 APP 纯离线运行,无网络权限 -->

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".KnowledgeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 极简文件提供器:用于拍照临时文件与分享图片 -->
        <provider
            android:name=".provider.AppFileProvider"
            android:authorities="com.pindou.app.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
