<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pindou.app">
    <!-- 本地原生构建(build_apk.bat)的 aapt2 需要 package 属性;
         Gradle/AGP 8 侧以 namespace 为准,保留此属性仅产生告警 -->

    <!-- 仅 Android 9 及以下保存到相册需要;Android 10+ 用 MediaStore 无需权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- AR 试摆(假 AR)实时取景需要;相机画面仅在本地使用,不保存不上传 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 有相机更好,没有也不影响其他功能 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Android 11+ 包可见性过滤:不声明 <queries> 时拍照 Intent 解析不到任何
         相机应用,startActivityForResult 直接抛 ActivityNotFoundException,
         真机上表现为点"拍一张照片"弹"没有可用的相机应用"(v2.61 修复) -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
    </queries>
    <!-- v2.26 起云端 AI 已移除:全 APP 纯离线运行,无网络权限 -->

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 首次启动三页引导(v2.60) -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".EditorActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <!-- 外部打开图纸(v2.57):微信/QQ/文件管理器里点开 .json 图纸直达导入。
                 content:// 为主(file:// 兼容老文件管理器);application/json 之外的
                 二进制流(octet-stream)也声明——部分应用对 json 不给准确 MIME,
                 导入时用 PatternShare.parse 严格校验,不对就提示并退出 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- 接收"以文件形式分享"的单张图纸(部分应用走 SEND 而不是 VIEW) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <activity
            android:name=".KnowledgeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PaletteActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".InventoryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".ColorMatchActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".FakeArActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ProjectAlignActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".LayeredComposeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".VerifyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".Play3DActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 极简文件提供器:用于拍照临时文件与分享图片 -->
        <provider
            android:name=".provider.AppFileProvider"
            android:authorities="com.pindou.app.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
